APP_NAME="SAO-IS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://192.168.1.200

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sao_is
DB_USERNAME=sao_user
DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=192.168.1.200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

SANCTUM_STATEFUL_DOMAINS=192.168.1.200

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=sao@mmcl.edu.ph
MAIL_FROM_NAME="SAO-IS"

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI=http://192.168.1.200/api/v1/auth/ms365/callback

VITE_APP_NAME="${APP_NAME}"

# Ollama AI Configuration
OLLAMA_API_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=gemma4:e4b
OLLAMA_VISION_MODEL=gemma4:e4b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_NOTIFICATION_TIMEOUT_SECONDS=8
